# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never commit credentials (Activity 5 security reminder).
# Each group member creates this locally via:
#   Tools > SALINLAHI > Create Supabase Config
# See Assets/Resources/SupabaseConfig.example.txt
Assets/Resources/SupabaseConfig.asset
Assets/Resources/SupabaseConfig.asset.meta

# The ElevenLabs key, for Tools/generate_music.py and the voice-over.
# It is a BILLING credential - leaked, someone else spends the plan.
#   printf '%s\n' 'YOUR-KEY' > Tools/elevenlabs.key && chmod 600 Tools/elevenlabs.key
# See Tools/elevenlabs.key.example.txt
Tools/elevenlabs.key

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for ignored folders
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics / profiler
crashlytics-build.properties
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Editor scratch
.utmp/

# Leftovers from cloud/network-synced filesystems (deleted-but-still-open files)
.fuse_hidden*

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db

# A Claude installer that landed in the project folder; never part of the game.
Claude Setup*.exe

# Python bytecode from the Tools/ scripts
__pycache__/
*.pyc

# Build output of the Activity 10 CPU probe (Tools/perf_probe). The project
# file and its one source file are tracked; the compiled assembly is not.
Tools/perf_probe/bin/
Tools/perf_probe/obj/

# ...but the probe's own project file is hand written, not generated by Unity,
# so it is tracked despite the *.csproj rule above.
!Tools/perf_probe/perf_probe.csproj
