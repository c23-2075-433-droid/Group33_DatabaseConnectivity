  - id: rachel_frame_sabihin
    text: 'Sabihin mo:'
    gloss: 'Say:'
    clip: {fileID: 0}
  - id: rachel_frame_ngayon
    text: 'Ngayon naman, sabihin mo:'
    gloss: 'Now, say:'
    clip: {fileID: 0}
  - id: rachel_frame_ulitin
    text: 'Pakinggan mo ulit:'
    gloss: 'Listen again:'
    clip: {fileID: 0}
  - id: rachel_cue_listening
    text: Nakikinig ako. I am listening!
    gloss: I am listening.
    clip: {fileID: 0}
  - id: rachel_hint_pakinggan
    text: Pakinggan mong mabuti. Listen carefully.
    gloss: Listen carefully.
    clip: {fileID: 0}
  - id: rachel_hint_replay
    text: Press the blue button to hear the word again.
    gloss: 
    clip: {fileID: 0}
  - id: rachel_nudge_idle
    text: Kaya mo 'yan! Go on, you can do it.
    gloss: You can do it!
    clip: {fileID: 0}
  - id: rachel_mic_blocked
    text: Press the microphone button so Kylo can hear you.
    gloss: 
    clip: {fileID: 0}
  - id: rachel_feedback_correct_1
    text: Tama! That's right!
    gloss: Correct!
    clip: {fileID: 0}
  - id: rachel_feedback_correct_2
    text: Magaling! Well done!
    gloss: Well done!
    clip: {fileID: 0}
  - id: rachel_feedback_correct_3
    text: Ang galing mo! You did it!
    gloss: Great job!
    clip: {fileID: 0}
  - id: rachel_feedback_incorrect_1
    text: Hindi pa tama. Let's try that one again.
    gloss: Not quite. Try again.
    clip: {fileID: 0}
  - id: rachel_feedback_incorrect_2
    text: Malapit na! You are very close. One more try.
    gloss: Almost! Say it again.
    clip: {fileID: 0}
  - id: rachel_feedback_nothear_1
    text: Hindi kita narinig. I did not hear you - try once more.
    gloss: I did not hear you.
    clip: {fileID: 0}
  - id: rachel_feedback_nothear_2
    text: Pakilakasan mo ang boses mo. A little louder, please!
    gloss: Speak a bit louder.
    clip: {fileID: 0}
