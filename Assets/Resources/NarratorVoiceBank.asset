    gloss: 
    clip: {fileID: 0}
  - id: rachel_l3_s4_ibahagi_done
    text: How kind! Everyone has something to eat now.
    gloss: 
    clip: {fileID: 8300000, guid: 978daaa5a258b4c63bb11cb998f0b552, type: 3}
  - id: rachel_l3_s4_inom_story
    text: All that running has made the whole group very thirsty.
    gloss: 
    clip: {fileID: 8300000, guid: 0d554ca8a65764a92aba260d2b443bd5, type: 3}
  - id: rachel_l3_s4_inom_ask
