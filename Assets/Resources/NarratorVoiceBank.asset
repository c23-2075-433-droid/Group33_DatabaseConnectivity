--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e7f30f51b8ce4acb88ac528f35c4f85d, type: 3}
  m_Name: NarratorVoiceBank
  m_EditorClassIdentifier: 
  captionFont: {fileID: 12800000, guid: 2c4d93be511cf4720910a1b57c26f54f, type: 3}
  lines:
  - id: 'rachel_l1_s1_intro'
    text: 'Good morning! Kylo needs to get ready for school. Help him get out of bed and start his morning!'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l1_s1_outro'
    text: 'Great job! Now help Kylo get to the bathroom.'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l1_s2_intro'
    text: 'Kylo needs to get ready before school. Help him find the bathroom and get ready for his morning bath!'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l1_s2_outro'
    text: 'Nice! Kylo is ready for his bath.'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l1_s3_intro'
    text: 'Kylo needs to get clean before going to school. Help him finish his morning routine!'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l1_s3_outro'
    text: 'Wonderful! Kylo is all clean and ready to get dressed.'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l1_s4_intro'
    text: 'It''s almost time for school! Help Kylo put on his uniform and prepare his things.'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l1_s4_outro'
    text: 'Perfect! Kylo is dressed and ready. But first, he needs breakfast!'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l1_s5_intro'
    text: 'Before going to school, Kylo needs a good breakfast. Help him eat and drink!'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l1_s5_bonus'
    text: 'Can you find the kanin and itlog?'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l1_s5_outro'
    text: 'Yummy! Kylo has finished his breakfast.'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l1_s6_intro'
    text: 'It''s time for school! Help Kylo get to the door and say goodbye to Nanay.'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l1_s6_outro'
    text: 'Great job! Kylo is ready for school. Let''s go!'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l1_complete_summary'
    text: 'You helped Kylo finish his morning routine!'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l1_complete_badge'
    text: 'Bahay Badge Unlocked!'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l2_s1_intro'
    text: 'Kylo has arrived at school! Help him enter the school and get to class before the bell rings.'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l2_s1_outro'
    text: 'You made it! Now let''s go to the classroom.'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l2_s2_intro'
    text: 'Class is about to begin. Help Kylo get ready for his lesson.'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l2_s2_outro'
    text: 'Everyone is ready. It''s time to learn!'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l2_s3_intro'
    text: 'Now it''s Kylo''s turn to learn some new Filipino words. Help him participate in class!'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l2_s3_outro'
    text: 'Excellent! Kylo is learning new words.'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l2_s4_intro'
    text: 'It''s recess! Help Kylo enjoy his break and make some friends.'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l2_s4_outro'
    text: 'That was fun! But recess is over. Let''s go back to class.'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l2_s5_intro'
    text: 'The school day is almost over. Help Kylo clean up and prepare to go home.'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l2_complete_summary'
    text: 'Great job! Kylo finished his school day!'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l2_complete_badge'
    text: 'Paaralan Badge Unlocked!'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l3_s1_intro'
    text: 'Kylo wants to relax at the park after school. Help him get there safely!'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l3_s2_intro'
    text: 'The playground is waiting! Help Kylo enjoy the different activities.'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l3_s2_outro'
    text: 'Wow! Kylo is having so much fun!'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l3_s3_intro'
    text: 'Look! Kylo met some new friends. Help him introduce himself and play with them.'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l3_s4_intro'
    text: 'After playing, Kylo and his new friends are hungry. Help them enjoy their snack together.'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l3_s4_outro'
    text: 'Sharing makes snack time even better!'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l3_s5_intro'
    text: 'The day is almost over. Help Kylo say goodbye to his friends and head home.'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l3_complete_summary'
    text: 'Amazing! Kylo had a wonderful day!'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_l3_complete_badge'
    text: 'Parke Badge Unlocked!'
    gloss: ''
    clip: {fileID: 0}
  - id: 'rachel_feedback_correct_1'
    text: 'Tama!'
    gloss: 'Correct!'
    clip: {fileID: 0}
  - id: 'rachel_feedback_correct_2'
    text: 'Magaling!'
    gloss: 'Well done!'
    clip: {fileID: 0}
  - id: 'rachel_feedback_correct_3'
    text: 'Ang galing mo!'
    gloss: 'Great job!'
    clip: {fileID: 0}
  - id: 'rachel_feedback_incorrect_1'
    text: 'Hindi pa tama. Subukan mo ulit.'
    gloss: 'Not quite. Try again.'
    clip: {fileID: 0}
  - id: 'rachel_feedback_incorrect_2'
    text: 'Malapit na! Ulitin mo.'
    gloss: 'Almost! Say it again.'
    clip: {fileID: 0}
  - id: 'rachel_frame_sabihin'
    text: 'Sabihin mo:'
    gloss: 'Say:'
    clip: {fileID: 0}
  - id: 'rachel_frame_ngayon'
    text: 'Ngayon naman, sabihin mo:'
    gloss: 'Now, say:'
    clip: {fileID: 0}
  - id: 'rachel_frame_ulitin'
    text: 'Pakinggan mo ulit:'
    gloss: 'Listen again:'
    clip: {fileID: 0}
  - id: 'rachel_cue_listening'
    text: 'Nakikinig ako.'
    gloss: 'I am listening.'
    clip: {fileID: 0}
  - id: 'rachel_hint_pakinggan'
    text: 'Pakinggan mong mabuti.'
    gloss: 'Listen carefully.'
    clip: {fileID: 0}
  - id: 'rachel_hint_replay'
    text: 'Pindutin ang asul na buton para marinig ulit.'
    gloss: 'Press the blue button to hear it again.'
    clip: {fileID: 0}
  - id: 'rachel_feedback_nothear_1'
    text: 'Hindi kita narinig. Pakiulit.'
    gloss: 'I did not hear you. Please repeat.'
    clip: {fileID: 0}
  - id: 'rachel_feedback_nothear_2'
    text: 'Pakilakasan mo ang boses mo.'
    gloss: 'Please speak a bit louder.'
    clip: {fileID: 0}
  - id: 'rachel_nudge_idle'
    text: 'Sabihin mo na. Kaya mo yan!'
    gloss: 'Go on, say it. You can do it!'
    clip: {fileID: 0}
  - id: 'rachel_mic_blocked'
    text: 'Pindutin ang mikropono para magsalita.'
    gloss: 'Press the microphone to speak.'
    clip: {fileID: 0}
