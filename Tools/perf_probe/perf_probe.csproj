<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Activity 10 CPU probe.

    It compiles the SHIPPING PronunciationChecker.cs and WordVariants.cs out of
    Assets/Scripts by reference, with no copy and no edit, so what is measured
    and what the APK runs are the same source. Both files are plain C# with no
    UnityEngine dependency, which is why this is possible at all.

    Run it with the .NET SDK that ships inside the Unity install, so no extra
    download is needed:

      "D:\Unity\6000.6.2f1\Editor\Data\DotNetSdk\dotnet.exe" run -c Release
          with the project switch pointed at Tools/perf_probe

    A desktop JIT is not a phone running IL2CPP, so the microsecond figures are
    an order of magnitude rather than a device number. That is enough for the
    question being asked: whether the right and wrong judgement is anywhere
    near expensive enough to matter per voice attempt.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>perf_probe</AssemblyName>
    <RootNamespace>perf_probe</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\..\..\Assets\Scripts\PronunciationChecker.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\..\..\Assets\Scripts\WordVariants.cs" />
  </ItemGroup>

</Project>
